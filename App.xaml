<Application x:Class="QuickPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Fallback brushes; ThemeService los reemplaza al iniciar -->
        <SolidColorBrush x:Key="Md3Primary" Color="#B7BAF7"/>
        <SolidColorBrush x:Key="Md3OnPrimary" Color="#1E1B3A"/>
        <SolidColorBrush x:Key="Md3PrimaryContainer" Color="#3D3A6B"/>
        <SolidColorBrush x:Key="Md3OnPrimaryContainer" Color="#E3E1FF"/>
        <SolidColorBrush x:Key="Md3Surface" Color="#16171D"/>
        <SolidColorBrush x:Key="Md3SurfaceContainer" Color="#1F2029"/>
        <SolidColorBrush x:Key="Md3SurfaceContainerHigh" Color="#282A35"/>
        <SolidColorBrush x:Key="Md3OnSurface" Color="#E6E6EB"/>
        <SolidColorBrush x:Key="Md3OnSurfaceVariant" Color="#A5A6B2"/>
        <SolidColorBrush x:Key="Md3Outline" Color="#43444F"/>
        <SolidColorBrush x:Key="Md3Error" Color="#F2B8B5"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>

        <!-- Botón de barra de título -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariant}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBtnClose" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle pill "Mantener activo" (modo Lite): switch + texto -->
        <Style x:Key="KeepAliveToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="pill" Height="22" CornerRadius="11"
                                Background="{DynamicResource Md3SurfaceContainerHigh}"
                                Padding="4,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Track del switch -->
                                <Border x:Name="track" Width="24" Height="14" CornerRadius="7"
                                        Background="{DynamicResource Md3Outline}" Margin="0,0,5,0">
                                    <Ellipse x:Name="knob" Width="10" Height="10" Fill="White"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <TextBlock x:Name="lbl" Text="Mantener activo" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled button MD3 -->
        <Style x:Key="Md3FilledButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Md3Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text button MD3 -->
        <Style x:Key="Md3TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox MD3 con placeholder via Tag -->
        <Style x:Key="Md3TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Md3Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Md3OnSurfaceVariant}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Tarjeta de selección de tamaño (S/M/L): reemplaza el RadioButton nativo
             por una tarjeta con borde resaltado cuando está seleccionada. -->
        <Style x:Key="SizeCardRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Width="64" Height="64" CornerRadius="14"
                                Background="{DynamicResource Md3SurfaceContainer}"
                                BorderBrush="{DynamicResource Md3Outline}" BorderThickness="1.4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem MD3: filas del popup desplegable (tema oscuro/claro vía DynamicResource,
             en vez del estilo nativo de Windows que siempre abre con fondo blanco). -->
        <Style x:Key="Md3ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Md3PrimaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox MD3: caja cerrada + popup desplegable, ambos con la paleta de la app. -->
        <Style x:Key="Md3ComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurface}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Md3ComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                       Content="{TemplateBinding SelectionBoxItem}"
                                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="⌄" FontSize="11" Margin="8,0,2,0"
                                               Foreground="{DynamicResource Md3OnSurfaceVariant}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   MinWidth="{TemplateBinding ActualWidth}">
                                <Border Background="{DynamicResource Md3SurfaceContainerHigh}"
                                        BorderBrush="{DynamicResource Md3Outline}" BorderThickness="1"
                                        CornerRadius="12" Margin="0,4,0,0" Padding="2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Switch MD3 ═══
             Reemplaza al CheckBox nativo manteniendo la misma API (IsChecked / Click), así el
             code-behind no cambia. Texto a la izquierda, switch a la derecha (fila de ajuste).
             Track 52×32. Apagado: thumb 16px con contorno; encendido: thumb 24px con ✓ sobre
             el color primario. El thumb se desliza y crece con una animación; el halo es la
             "state layer" de hover. -->
        <Style x:Key="Md3Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurface}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                              RecognizesAccessKey="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Grid Grid.Column="1" Width="52" Height="32" Margin="0,4" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="16" BorderThickness="2"
                                        Background="{DynamicResource Md3SurfaceContainerHigh}"
                                        BorderBrush="{DynamicResource Md3Outline}"/>

                                <!-- Knob: halo + thumb + ✓, se traslada en X (centro 16 → 36). -->
                                <Grid x:Name="Knob" Width="40" Height="40" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" Margin="-4,-4,0,-4">
                                    <Grid.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="Halo" Fill="{DynamicResource Md3OnSurface}" Opacity="0"/>
                                    <Ellipse x:Name="Thumb" Width="24" Height="24"
                                             Fill="{DynamicResource Md3OnSurfaceVariant}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="0.667" ScaleY="0.667"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="Check" Text="✓" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource Md3Primary}" Opacity="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Md3OnPrimary}"/>
                                <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Md3Primary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" BeginTime="0:0:0.08" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.667" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.667" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Selector segmentado MD3 ═══
             Para opciones excluyentes con nombre (Material/Dock, tema): RadioButtons del mismo
             GroupName dentro de un contenedor "Md3SegmentTrack". La opción activa se ve como
             una píldora rellena con el color primario. Misma API que un RadioButton. -->
        <Style x:Key="Md3SegmentTrack" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Md3Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="Md3Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariant}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="16" Padding="16,7" MinWidth="84"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="✓ " FontWeight="Bold" Visibility="Collapsed"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Md3SurfaceContainerHigh}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Md3Primary}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
