<Window x:Class="QuickPanel.Settings.EditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:QuickPanel.Services"
        Title="QuickPanel"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize">

    <Border CornerRadius="20" Background="{DynamicResource Md3Surface}"
            BorderBrush="{DynamicResource Md3Outline}" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16" MouseLeftButtonDown="Header_Drag" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconHost" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                            Background="{DynamicResource Md3SurfaceContainerHigh}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc EditApp_Title}" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource Md3OnSurface}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Loc EditApp_Name}" Style="{StaticResource SettingLabel}"/>
            <TextBox x:Name="InName" Style="{StaticResource Md3TextBox}" Margin="0,0,0,14"/>

            <TextBlock Text="URL" Style="{StaticResource SettingLabel}"/>
            <TextBox x:Name="InUrl" Style="{StaticResource Md3TextBox}" Tag="https://..."/>
            <TextBlock Text="{loc:Loc EditApp_UrlHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource Md3OnSurfaceVariant}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Loc Common_Cancel}" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource Md3TextButton}" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Common_Save}" Click="Save_Click" IsDefault="True"
                        Style="{StaticResource Md3FilledButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
