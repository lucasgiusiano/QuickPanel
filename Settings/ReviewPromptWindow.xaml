<Window x:Class="QuickPanel.Settings.ReviewPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:QuickPanel.Services"
        Title="QuickPanel"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize">

    <Border CornerRadius="20" Background="{DynamicResource Md3Surface}"
            BorderBrush="{DynamicResource Md3Outline}" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="24">
            <TextBlock Text="⭐" FontSize="28" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <TextBlock Text="{loc:Loc Review_Title}" FontSize="17" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource Md3OnSurface}" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:Loc Review_Body}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3OnSurfaceVariant}" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Review_Later}" Click="Later_Click"
                        Style="{StaticResource Md3TextButton}" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Review_Rate}" Click="Rate_Click" IsDefault="True"
                        Style="{StaticResource Md3FilledButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
